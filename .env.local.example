# ============================================================
# mesbian-linor Environment Configuration
# ============================================================

# ── Admin Panel Authentication ──────────────────────────────
# 4-digit numeric PIN for /admin access (e.g. configured on server)
ADMIN_PIN=your_4_digit_admin_pin

# Secret key used on the server to sign admin session tokens
ADMIN_SESSION_SECRET=your_super_secret_admin_session_key_min_32_chars

# ── Visitor Access Passcode ─────────────────────────────────
# Initial 3-digit numeric visitor passcode (can also be changed via /admin)
VISITOR_CODE=your_3_digit_visitor_code

# Secret key used on the server to sign visitor verification cookies
VISITOR_CODE_SECRET=your_super_secret_visitor_token_key_min_32_chars

# ── Supabase (Optional in dev, required for cloud sync) ─────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Server-only key for authoritative database writes — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
