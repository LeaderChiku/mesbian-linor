# ============================================================
# mesbian-linor — Local Development Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
#
# Variable status legend:
#   [REQUIRED]  — Must be set in production; app is insecure or broken without it.
#   [OPTIONAL]  — Safe to omit; a documented default applies.
# ============================================================

# ── Admin Panel Authentication ───────────────────────────────
# [REQUIRED] 4-digit numeric PIN protecting the /admin route.
# Verified server-side only; never exposed to the browser.
ADMIN_PIN=your_4_digit_admin_pin

# [REQUIRED] 32+ character random secret used to sign and verify the
# HMAC-SHA256 admin session cookie (mbl_admin_session).
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=your_super_secret_admin_session_key_min_32_chars

# ── Visitor Access Passcode ──────────────────────────────────
# [REQUIRED] 3-digit numeric passcode shown to the visitor at the access screen.
# Verified server-side only; never exposed to the browser.
VISITOR_CODE=your_3_digit_visitor_code

# [REQUIRED] 32+ character random secret used to sign visitor verification cookies.
# Generate one with: openssl rand -hex 32
VISITOR_CODE_SECRET=your_super_secret_visitor_token_key_min_32_chars

# ── Supabase — Public (Browser) Credentials ─────────────────
# [REQUIRED for cloud sync] Your Supabase project URL.
# Find it at: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [REQUIRED for cloud sync] Your Supabase anon/public key.
# Find it at: Supabase Dashboard → Project Settings → API → Project API Keys → anon / public
# Safe to expose in the browser — RLS policies protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# [OPTIONAL — Phase 3 server-side writes] Supabase service_role secret key.
# Required only when server-side API routes need to bypass RLS to write authoritative data.
# NEVER prefix with NEXT_PUBLIC_ — must remain server-only.
# Find it at: Supabase Dashboard → Project Settings → API → Project API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ── Optional Schedule Override ───────────────────────────────
# [OPTIONAL] ISO 8601 UTC timestamp to pre-seed the server-side countdown
# on first boot before the admin sets a schedule via /admin.
# Example: NEXT_PUBLIC_SCHEDULED_AT=2026-11-15T18:00:00.000Z
# NEXT_PUBLIC_SCHEDULED_AT=

# ── Notes on Vercel Auto-Provisioned Variables ───────────────
# Vercel's Supabase integration may inject variables named:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY,
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY,
#   SUPABASE_JWT_SECRET, POSTGRES_URL, POSTGRES_URL_NON_POOLING,
#   POSTGRES_PRISMA_URL, POSTGRES_USER, POSTGRES_DATABASE,
#   POSTGRES_HOST, POSTGRES_PASSWORD
#
# NONE of the above are read by this application.
# This app only reads NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY.
# You must manually add those two variables in Vercel using the exact names above.
